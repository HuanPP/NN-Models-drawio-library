ometry"/></mxCell><mxCell id="n6" value="Rotate pair i&lt;br&gt;by angle mθ&lt;sub&gt;i&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="g"><mxGeometry x="10" y="130" width="150" height="36" as="geometry"/></mxCell><mxCell id="n7" value="cos pθ&lt;sub&gt;i&lt;/sub&gt;, sin pθ&lt;sub&gt;i&lt;/sub&gt;&lt;br&gt;(p = m, n)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="g"><mxGeometry x="200" y="130" width="130" height="36" as="geometry"/></mxCell><mxCell id="n8" value="Rotate pair i&lt;br&gt;by angle nθ&lt;sub&gt;i&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="g"><mxGeometry x="370" y="130" width="150" height="36" as="geometry"/></mxCell><mxCell id="n9" value="R&lt;sub&gt;m&lt;/sub&gt; q&lt;sub&gt;m&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontStyle=1;" vertex="1" parent="g"><mxGeometry x="10" y="190" width="150" height="30" as="geometry"/></mxCell><mxCell id="n10" value="R&lt;sub&gt;n&lt;/sub&gt; k&lt;sub&gt;n&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="g"><mxGeometry x="370" y="190" width="150" height="30" as="geometry"/></mxCell><mxCell id="n11" value="·" style="shape=ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontColor=#333333;strokeWidth=1.5;fontStyle=1;fontFamily=Times New Roman;fillColor=#FFFFFF;strokeColor=#666666;fontSize=16;" vertex="1" parent="g